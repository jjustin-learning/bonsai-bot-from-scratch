{
  "name": "bonsai-bot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "database"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun src/deploy-commands.ts",
    "check-types": "tsc --noEmit",
    "db:studio": "cd database && bunx prisma studio",
    "db:generate": "cd database && bunx prisma generate",
    "db:migrate:dev": "cd database && bunx prisma migrate dev",
    "db:migrate:reset": "cd database && bunx prisma migrate reset --force",
    "docker:dev": "docker compose -f docker-compose.yml up --build -d",
    "scrape": "bun src/scraper.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7",
    "@repo/database": "workspace:*",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  }
}
